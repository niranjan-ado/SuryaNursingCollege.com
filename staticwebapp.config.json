{
  "trailingSlash": "never",
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/css/*",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/js/*",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/index.html",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/about.html",
      "redirect": "/about",
      "statusCode": 301
    },
    {
      "route": "/courses.html",
      "redirect": "/courses",
      "statusCode": 301
    },
    {
      "route": "/facilities.html",
      "redirect": "/facilities",
      "statusCode": 301
    },
    {
      "route": "/faculty.html",
      "redirect": "/faculty",
      "statusCode": 301
    },
    {
      "route": "/admissions.html",
      "redirect": "/admissions",
      "statusCode": 301
    },
    {
      "route": "/faq.html",
      "redirect": "/faq",
      "statusCode": 301
    },
    {
      "route": "/contact.html",
      "redirect": "/contact",
      "statusCode": 301
    },
    {
      "route": "/blog.html",
      "redirect": "/blog",
      "statusCode": 301
    },
    {
      "route": "/anm-syllabus.html",
      "redirect": "/anm-syllabus",
      "statusCode": 301
    },
    {
      "route": "/gnm-syllabus.html",
      "redirect": "/gnm-syllabus",
      "statusCode": 301
    },
    {
      "route": "/bsc-nursing-syllabus.html",
      "redirect": "/bsc-nursing-syllabus",
      "statusCode": 301
    },
    {
      "route": "/exam-time-table.html",
      "redirect": "/exam-time-table",
      "statusCode": 301
    },
    {
      "route": "/academics.html",
      "redirect": "/academics",
      "statusCode": 301
    },
    {
      "route": "/blog/why-choose-nursing.html",
      "redirect": "/blog/why-choose-nursing",
      "statusCode": 301
    },
    {
      "route": "/blog/a-day-at-surya-nursing.html",
      "redirect": "/blog/a-day-at-surya-nursing",
      "statusCode": 301
    },
    {
      "route": "/blog/preparing-for-nursing-exams.html",
      "redirect": "/blog/preparing-for-nursing-exams",
      "statusCode": 301
    },
    {
      "route": "/blog/5-habits-aspiring-nurses.html",
      "redirect": "/blog/5-habits-aspiring-nurses",
      "statusCode": 301
    },
    {
      "route": "/blog/nursing-frontlines.html",
      "redirect": "/blog/nursing-frontlines",
      "statusCode": 301
    },
    {
      "route": "/blog/author-niranjan-ramamurthy.html",
      "redirect": "/blog/author-niranjan-ramamurthy",
      "statusCode": 301
    },
    {
      "route": "/principal",
      "redirect": "/about",
      "statusCode": 301
    },
    {
      "route": "/README.md",
      "statusCode": 404
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; media-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com; frame-src https://www.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  }
}
